# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# Only if your key is an organization key not scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional
# AIOS_API_TOKEN=choose-a-long-random-string   # require a bearer token for the local API/dashboard
# AIOS_DATABASE_URL=sqlite:///data/aios.db      # or postgresql+psycopg://user:pass@host/db
# AIOS_PORT=8787
# AIOS_WEB_SEARCH=1                              # 0 disables live web search for research
# Studio (voice clone + avatar videos) — see README → Studio
# REPLICATE_API_TOKEN=r8_...                     # cloud GPU for lip-sync, ~$0.10 per short video
# AIOS_TTS_PYTHON=/path/to/aios/.venv-tts/bin/python   # set by scripts/setup_studio.sh
# Multi-model (all optional; see `aios models`)
# MODEL_API_KEY=...           # Muse Spark via Meta Model API (paid per token, US public preview)
# OPENAI_API_KEY=sk-...       # ChatGPT models via OpenAI API (paid; ChatGPT Plus doesn't include API use)
# TYPESAFE_API_KEY=...        # Jev, routes tasks (optional; keyword rules otherwise)
# AIOS_OLLAMA=1               # free local models via Ollama on this Mac
